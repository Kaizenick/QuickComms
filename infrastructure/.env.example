# A DNS name whose A record points to this VM.
DOMAIN=voice.example.com
# The VM's public IPv4 address.
PUBLIC_IP=203.0.113.10
# Replace both values with long random strings.
TURN_USERNAME=quickcomms
TURN_PASSWORD=replace-with-a-long-random-secret
# Copy your token from the DuckDNS account page. Never commit the real token.
DUCKDNS_API_TOKEN=replace-with-your-duckdns-token
